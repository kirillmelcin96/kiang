{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "log:default",
    "log:allow-log",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:11434/**" },
        {
          "url": "https://raw.githubusercontent.com/kirillmelcin96/kiang/refs/heads/main/CHANGELOG.md"
        },
        {
          "url": "https://huggingface.co/api*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/kirillmelcin96/kiang"
        },
        {
          "url": "https://github.com/kirillmelcin96/kiang*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "https://ollama.com/library*"
        },
        {
          "url": "https://huggingface.co*"
        }
      ]
    }
  ]
}
