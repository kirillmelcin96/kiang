{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kiang",
  "version": "1.5.1",
  "identifier": "com.kirillmelcin96.kiang",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Kiang",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "decorations": true,
        "minWidth": 480,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5Qzg0RDZENkE0Q0QyRTgKUldUbzBreHFiVTNJK1hoYytUYTBJU2lzcjY3S3hMWFFqQklPWitXeFU0YTVBQXZyNmNDQWRvS2gK",
      "endpoints": ["https://github.com/kirillmelcin96/kiang/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
